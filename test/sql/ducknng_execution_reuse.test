# name: test/sql/ducknng_execution_reuse.test
# group: [ducknng]
#
# A prepared plan holds only immutable arguments. Every EXECUTE performs its
# own remote work and reports the reply it received: fixed-schema exec runs the
# mutation again, explicit session helpers report the current remote session
# state, uploads upload again, and aio collection reports the handle's current
# state. Preparing a plan sends, waits on, and consumes nothing.

require ducknng

statement ok
SELECT ducknng_start_server('er', 'inproc://ducknng-execution-reuse',
  1, 134217728, 300000, 0::UBIGINT)

statement ok
SELECT ducknng_register_exec_method()

statement ok
SELECT ducknng_register_upload_methods()

statement ok
CREATE SEQUENCE er_seq START 1

statement ok
CREATE TABLE er_t(i BIGINT)

# Fixed-schema exec: two executions are two inserts and two sequence advances.
statement ok
PREPARE er_exec AS
SELECT ok, error, rows_changed FROM ducknng_run_rpc('inproc://ducknng-execution-reuse',
  'INSERT INTO er_t VALUES (nextval(''er_seq''))', 0::UBIGINT)

query I
SELECT count(*) FROM er_t
----
0

query ITI
EXECUTE er_exec
----
true	NULL	1

query ITI
EXECUTE er_exec
----
true	NULL	1

query II
SELECT count(*), max(i) FROM er_t
----
2	2

query I
SELECT currval('er_seq')
----
2

# Explicit session helpers: the caller owns the cursor.
statement ok
CREATE TEMP TABLE er_open AS
SELECT * FROM ducknng_open_query('inproc://ducknng-execution-reuse',
  'SELECT i::BIGINT AS i FROM range(7000) t(i)', 1::UBIGINT, 0::UBIGINT, 0::UBIGINT)

statement ok
SET VARIABLE er_sid = (SELECT session_id FROM er_open)

statement ok
SET VARIABLE er_token = (SELECT session_token FROM er_open)

statement ok
CREATE TEMP TABLE er_fetched(ok BOOLEAN, payload BLOB, end_of_stream BOOLEAN)

statement ok
PREPARE er_fetch AS
INSERT INTO er_fetched
SELECT ok, payload, end_of_stream
FROM ducknng_fetch_query('inproc://ducknng-execution-reuse',
  getvariable('er_sid')::UBIGINT, getvariable('er_token')::VARCHAR,
  1::UBIGINT, 0::UBIGINT, 0::UBIGINT)

statement ok
PREPARE er_close AS
SELECT ok, error FROM ducknng_close_query('inproc://ducknng-execution-reuse',
  getvariable('er_sid')::UBIGINT, getvariable('er_token')::VARCHAR, 0::UBIGINT)

statement ok
PREPARE er_cancel AS
SELECT ok, error FROM ducknng_cancel_query('inproc://ducknng-execution-reuse',
  getvariable('er_sid')::UBIGINT, getvariable('er_token')::VARCHAR, 0::UBIGINT)

# Preparing fetched nothing; decode each separately executed Arrow batch.
statement ok
EXECUTE er_fetch

query III
SELECT ok, payload IS NOT NULL, end_of_stream FROM er_fetched
----
true	true	false

statement ok
SET VARIABLE er_payload = (SELECT payload FROM er_fetched)

query II
SELECT min(i), count(*) > 0
FROM ducknng_parse_body(getvariable('er_payload'), 'application/vnd.apache.arrow.stream')
----
0	true

statement ok
SET VARIABLE er_first_max = (
  SELECT max(i) FROM ducknng_parse_body(
    getvariable('er_payload'), 'application/vnd.apache.arrow.stream')
)

statement ok
DELETE FROM er_fetched

statement ok
EXECUTE er_fetch

statement ok
SET VARIABLE er_payload = (SELECT payload FROM er_fetched)

query II
SELECT min(i) > getvariable('er_first_max'), count(*) > 0
FROM ducknng_parse_body(getvariable('er_payload'), 'application/vnd.apache.arrow.stream')
----
true	true

query IT
EXECUTE er_close
----
true	NULL

query IT
EXECUTE er_close
----
false	ducknng: session not found

query IT
EXECUTE er_cancel
----
false	ducknng: session not found

statement ok
DEALLOCATE er_fetch

statement ok
DEALLOCATE er_close

statement ok
DEALLOCATE er_cancel

# Upload: each execution opens its own upload session and appends again.
statement ok
CREATE TABLE er_up(i INTEGER)

statement ok
PREPARE er_upload AS
SELECT rows_uploaded FROM ducknng_upload_table('inproc://ducknng-execution-reuse',
  'SELECT i::INTEGER AS i FROM range(3) t(i)', 'er_up')

query I
SELECT count(*) FROM er_up
----
0

query I
EXECUTE er_upload
----
3

query I
EXECUTE er_upload
----
3

query II
SELECT count(*), sum(i) FROM er_up
----
6	6

# Aio collection: the first execution consumes the reply; the second reports
# that the handle is already collected rather than replaying the reply.
statement ok
CREATE TEMP TABLE er_aio AS
SELECT ducknng_run_rpc_raw_aio('inproc://ducknng-execution-reuse',
  'SELECT 1', 5000, 0::UBIGINT) AS aio_id

query I
SELECT ducknng_aio_wait((SELECT list_value(aio_id) FROM er_aio), 5000)
----
true

statement ok
PREPARE er_collect AS
SELECT ok, octet_length(frame) > 0
FROM ducknng_aio_collect((SELECT list_value(aio_id) FROM er_aio), 0)

query T
SELECT state FROM er_aio, ducknng_aio_status(aio_id)
----
ready

query II
EXECUTE er_collect
----
true	true

query T
SELECT state FROM er_aio, ducknng_aio_status(aio_id)
----
collected

query II
EXECUTE er_collect
----

query I
SELECT ducknng_aio_drop(aio_id) FROM er_aio
----
true

# Parameterized exec: the params STRUCT is encoded per execution, so each
# EXECUTE sends its own parameter values.
statement ok
CREATE TABLE er_p(i BIGINT)

statement ok
PREPARE er_exec_params AS
SELECT ok, error, rows_changed FROM ducknng_run_rpc_params(
  'inproc://ducknng-execution-reuse', 'INSERT INTO er_p VALUES (?)',
  struct_pack(p1 := $1::BIGINT), 0::UBIGINT)

query I
SELECT count(*) FROM er_p
----
0

query ITI
EXECUTE er_exec_params(10)
----
true	NULL	1

query ITI
EXECUTE er_exec_params(20)
----
true	NULL	1

query II
SELECT count(*), sum(i) FROM er_p
----
2	30

# Codec SQL runs on the runtime codec connection while holding it. Binding a
# parameterized call there succeeds because bind encodes nothing; executing
# it would reacquire the codec connection, so it reports a recursion error
# instead of blocking and sends nothing.
statement ok
CREATE MACRO er_codec_exec(b) AS (
  SELECT error FROM ducknng_run_rpc_params('inproc://ducknng-execution-reuse',
    'INSERT INTO er_p VALUES (?)', struct_pack(p1 := 99), 0::UBIGINT))

statement ok
CREATE MACRO er_codec_query(b) AS (
  SELECT CAST(v AS VARCHAR) FROM ducknng_query_rpc_params(
    'inproc://ducknng-execution-reuse', 'SELECT ?::INTEGER AS v',
    struct_pack(p1 := 1), 0::UBIGINT, schema := NULL::STRUCT(v INTEGER)))

statement ok
CREATE MACRO er_codec_upload(b) AS (
  SELECT CAST(rows_uploaded AS VARCHAR) FROM ducknng_upload_table(
    'inproc://ducknng-execution-reuse',
    'SELECT 1::INTEGER AS i', 'er_codec_up'))

query I
SELECT ducknng_register_codec('application/x-er-exec', 'er_codec_exec')
  AND ducknng_register_codec('application/x-er-query', 'er_codec_query')
  AND ducknng_register_codec('application/x-er-upload', 'er_codec_upload')
----
true

query T
SELECT value FROM ducknng_parse_body('x'::BLOB, 'application/x-er-exec')
----
ducknng: codec SQL cannot encode remote exec parameters

statement error
SELECT value FROM ducknng_parse_body('x'::BLOB, 'application/x-er-query')
----
codec SQL cannot encode remote query parameters

statement error
SELECT value FROM ducknng_parse_body('x'::BLOB, 'application/x-er-upload')
----
codec SQL cannot run an upload_table source_query

query I
SELECT count(*) FROM er_p
----
2

query I
SELECT count(*) FROM duckdb_tables() WHERE table_name = 'er_codec_up'
----
0

query I
SELECT ducknng_unregister_codec('application/x-er-exec')
  AND ducknng_unregister_codec('application/x-er-query')
  AND ducknng_unregister_codec('application/x-er-upload')
----
true

statement ok
DEALLOCATE er_exec_params

statement ok
DEALLOCATE er_collect

statement ok
DEALLOCATE er_upload

statement ok
DEALLOCATE er_exec

query I
SELECT ducknng_stop_server('er')
----
true
