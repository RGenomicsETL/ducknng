# name: test/sql/ducknng_public_surface.test
# group: [ducknng]

require ducknng

query I
WITH loaded AS (
  SELECT DISTINCT function_name AS name
  FROM duckdb_functions()
  WHERE function_name LIKE 'ducknng%'
    AND function_name NOT LIKE 'ducknng__%'
),
catalog AS (
  SELECT (unnest(functions)).name AS name
  FROM read_json_auto('function_catalog/functions.yaml')
)
SELECT count(*)::INTEGER
FROM (
  SELECT name FROM loaded
  EXCEPT
  SELECT name FROM catalog
)
----
0

query I
SELECT count(*)::INTEGER
FROM duckdb_functions()
WHERE function_name = 'ducknng__aio_mark_collected'
----
0
