# name: test/sql/ducknng_http_framework.test
# group: [ducknng]

require ducknng

query I
SELECT CASE
  WHEN ducknng_start_server('http_route_api', 'http://127.0.0.1:0/_ducknng', 1, 134217728, 300000, 0::UBIGINT)
  THEN 1 ELSE 0 END
----
1

statement ok
SET VARIABLE http_route_mount = (
  SELECT listen FROM ducknng_list_servers() WHERE name = 'http_route_api'
)

statement ok
SET VARIABLE http_route_base = replace(getvariable('http_route_mount')::VARCHAR, '/_ducknng', '')

statement ok
SET VARIABLE http_route_health_sql = 'SELECT 200 AS status, ''text/plain; charset=utf-8'' AS content_type, ''ok'' AS body_text'

query I
SELECT CASE WHEN ducknng_register_http_route(
  'http_route_api',
  'GET',
  '/healthz',
  getvariable('http_route_health_sql')::VARCHAR
) THEN 1 ELSE 0 END
----
1

query II
SELECT count(*), max(path = '/healthz')
FROM ducknng_list_http_routes()
WHERE service_name = 'http_route_api'
----
1	1

query IIT
SELECT ok, status = 200, body_text
FROM ducknng_ncurl(
  getvariable('http_route_base')::VARCHAR || '/healthz',
  'GET',
  NULL,
  NULL,
  2000,
  0::UBIGINT
)
----
1	1	ok

statement ok
SET VARIABLE http_route_echo_sql =
'SELECT 201 AS status,
        ''text/plain; charset=utf-8'' AS content_type,
        (
          SELECT method || '' '' || path || ''?'' || coalesce(query_string, '''') ||
                 '' '' || coalesce(content_type, '''') ||
                 '' '' || coalesce(body_text, '''')
          FROM ducknng_http_request(), ducknng_http_request_body()
        ) AS body_text'

query I
SELECT CASE WHEN ducknng_register_http_route(
  'http_route_api',
  'POST',
  '/echo',
  getvariable('http_route_echo_sql')::VARCHAR
) THEN 1 ELSE 0 END
----
1

query IIT
SELECT ok, status = 201, body_text
FROM ducknng_ncurl(
  getvariable('http_route_base')::VARCHAR || '/echo?x=1',
  'POST',
  '[{"name":"Content-Type","value":"text/plain"}]',
  'hello'::BLOB,
  2000,
  0::UBIGINT
)
----
1	1	POST /echo?x=1 text/plain hello

statement ok
SET VARIABLE http_route_gateway_sql =
'WITH req AS (
   SELECT json_extract_string(body_text::JSON, ''$.sql'') AS requested_sql
   FROM ducknng_http_request_body()
 )
 SELECT 200 AS status,
        ''application/json; charset=utf-8'' AS content_type,
        CAST(to_json(list(struct_pack(requested_sql := requested_sql, answer := 7))) AS VARCHAR) AS body_text
 FROM req'

query I
SELECT CASE WHEN ducknng_register_http_route(
  'http_route_api',
  'POST',
  '/v1/sql',
  getvariable('http_route_gateway_sql')::VARCHAR,
  4096::UBIGINT
) THEN 1 ELSE 0 END
----
1

query III
SELECT ok, status = 200, position('"requested_sql":"SELECT 7 AS answer"' IN body_text) > 0 AND position('"answer":7' IN body_text) > 0
FROM ducknng_ncurl(
  getvariable('http_route_base')::VARCHAR || '/v1/sql',
  'POST',
  '[{"name":"Content-Type","value":"application/json"}]',
  '{"sql":"SELECT 7 AS answer"}'::BLOB,
  2000,
  0::UBIGINT
)
----
1	1	1

query III
SELECT ok, status = 413, error IS NULL
FROM ducknng_ncurl(
  getvariable('http_route_base')::VARCHAR || '/v1/sql',
  'POST',
  '[{"name":"Content-Type","value":"application/json"}]',
  repeat('x', 5000)::BLOB,
  2000,
  0::UBIGINT
)
----
1	1	1

query I
SELECT CASE WHEN ducknng_unregister_http_route('http_route_api', 'GET', '/healthz') THEN 1 ELSE 0 END
----
1

query III
SELECT ok, status = 404, error IS NULL
FROM ducknng_ncurl(
  getvariable('http_route_base')::VARCHAR || '/healthz',
  'GET',
  NULL,
  NULL,
  2000,
  0::UBIGINT
)
----
1	1	1

query I
SELECT CASE WHEN ducknng_stop_server('http_route_api') THEN 1 ELSE 0 END
----
1
